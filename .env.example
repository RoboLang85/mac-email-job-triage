# Copy this file to .env. NEVER commit .env.

# Core
TRIAGE_DB_PATH=~/.mac-email-job-triage/triage.db
TRIAGE_OUTPUT_DIR=~/.mac-email-job-triage/output
TRIAGE_EMAIL_BODY_CHARS=4000
TRIAGE_FETCH_LIMIT=50
TRIAGE_CLASSIFY_BATCH_SIZE=4
TRIAGE_URGENCY_ESCALATE_THRESHOLD=4

# Ollama (local only by default)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=auto
OLLAMA_KEEP_ALIVE=10m
OLLAMA_TIMEOUT_SECONDS=300
OLLAMA_NUM_CTX=8192

# Gmail IMAP. Use a Gmail app password, not your normal account password.
GMAIL_ENABLED=false
GMAIL_USER=
GMAIL_APP_PASSWORD=
GMAIL_FOLDER=INBOX

# Outlook / Microsoft Graph delegated device-code auth.
OUTLOOK_ENABLED=false
MS_CLIENT_ID=
MS_TENANT_ID=consumers
MS_TOKEN_CACHE_PATH=~/.mac-email-job-triage/msal-token-cache.json
OUTLOOK_FOLDER=inbox

# Optional external/frontier escalation. OFF by default.
# Only the already-produced local triage summary is sent unless code is changed.
FRONTIER_ENABLED=false
FRONTIER_BASE_URL=
FRONTIER_API_KEY=
FRONTIER_MODEL=

# Job discovery/scoring
JOB_BOARDS_PATH=./job_boards.json
RESUME_PROFILE_PATH=./resume_profile.md
REMOTE_ONLY=true
